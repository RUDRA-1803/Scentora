# Scentora Server Environment Configuration Example

# Server Port
PORT=5000

# Node Environment ('development' | 'production')
NODE_ENV=development

# Frontend Client URL for CORS
CLIENT_URL=http://localhost:5173

# MongoDB Connection String (Replace with your local or MongoDB Atlas URI)
# Example local: mongodb://127.0.0.1:27017/scentora
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/scentora?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/scentora
